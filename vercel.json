{
  "builds": [
    {
      "src": "backend/emsight_backend/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.10"
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/emsight_backend/wsgi.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/backend/emsight_backend/wsgi.py"
    },
    {
      "src": "/media/(.*)",
      "dest": "/backend/emsight_backend/wsgi.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/backend/emsight_backend/wsgi.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/vite.svg",
      "dest": "/frontend/vite.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
